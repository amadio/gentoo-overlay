--- a/namespace/ns_quarkdb/qclient/include/qclient/ParallelRocksDBPersistency.hh
+++ b/namespace/ns_quarkdb/qclient/include/qclient/ParallelRocksDBPersistency.hh
@@ -139,9 +139,7 @@ private:
