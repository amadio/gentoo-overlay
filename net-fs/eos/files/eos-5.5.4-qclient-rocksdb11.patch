+//------------------------------------------------------------------------------
+// RocksDB 9.11 added DB::Open overloads taking std::unique_ptr<DB>*, and
+// RocksDB 10.1 removed the ones taking DB**. Support both.
+//------------------------------------------------------------------------------
+inline rocksdb::Status openRocksDB(const rocksdb::Options &options,
+  const std::string &path, std::unique_ptr<rocksdb::DB> &db) {
+#if ROCKSDB_MAJOR > 9 || (ROCKSDB_MAJOR == 9 && ROCKSDB_MINOR >= 11)
+  return rocksdb::DB::Open(options, path, &db);
+#else
+  rocksdb::DB *ptr = nullptr;
+  rocksdb::Status status = rocksdb::DB::Open(options, path, &ptr);
+  db.reset(ptr);
+  return status;
+#endif
+}
