-    rocksdb::DB *ptr = nullptr;
-    rocksdb::Status status = rocksdb::DB::Open(opts, dbpath, &ptr);
-    db.reset(ptr);
+    rocksdb::Status status = openRocksDB(opts, dbpath, db);
 
