From af675e75600bd8e8d08c37cd1ca05c2111aaa424 Mon Sep 17 00:00:00 2001
From: Guilherme Amadio <guilherme@amadio.org>
Date: Tue, 29 Sep 2026 20:13:36 +0200
Subject: [PATCH 1/3] CMAKE: Link glog explicitly when it is installed next to
 folly

Folly headers reference glog symbols directly, so objects including them
fail to link against a system folly where glog is only an indirect
dependency of libfolly.so.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Guilherme Amadio <guilherme@amadio.org>
---
 cmake/Findeosfolly.cmake | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/cmake/Findeosfolly.cmake b/cmake/Findeosfolly.cmake
index e4b2dfdd9..bf52b4897 100644
--- a/cmake/Findeosfolly.cmake
+++ b/cmake/Findeosfolly.cmake
@@ -29,6 +29,17 @@ find_package_handle_standard_args(eosfolly
 
 mark_as_advanced(EOSFOLLY_FOUND EOSFOLLY_LIBRARY EOSFOLLY_INCLUDE_DIR)
 
+# Folly headers use glog directly, so link glog explicitly if it is installed
+# next to folly, since linking fails when it is only an indirect dependency.
+if(EOSFOLLY_LIBRARY)
+  get_filename_component(EOSFOLLY_LIBRARY_DIR "${EOSFOLLY_LIBRARY}" DIRECTORY)
+  find_library(EOSFOLLY_GLOG_LIBRARY
+    NAMES glog
+    PATHS ${EOSFOLLY_LIBRARY_DIR}
+    NO_DEFAULT_PATH)
+  mark_as_advanced(EOSFOLLY_GLOG_LIBRARY)
+endif()
+
 if(EOSFOLLY_FOUND AND NOT TARGET FOLLY::FOLLY)
   # Note: this target is not used for the moment as the folly lib is only
   # liked directly into qclient.
@@ -38,6 +49,11 @@ if(EOSFOLLY_FOUND AND NOT TARGET FOLLY::FOLLY)
     INTERFACE_INCLUDE_DIRECTORIES "${EOSFOLLY_INCLUDE_DIR}"
     INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${EOSFOLLY_INCLUDE_DIR}"
     INTERFACE_COMPILE_DEFINITIONS HAVE_FOLLY)
+
+  if(EOSFOLLY_GLOG_LIBRARY)
+    set_property(TARGET FOLLY::FOLLY APPEND PROPERTY
+      INTERFACE_LINK_LIBRARIES "${EOSFOLLY_GLOG_LIBRARY}")
+  endif()
 endif()
 
 # This is done to preserve compatibility with qclient
